{
  "schema_version": 1,
  "framework_version": "1.0.0",
  "framework_source": ".engineering",
  "owner": "Ballzatram",
  "repository": "Ballzatram/beckwards",
  "risk_tier": "standard",
  "lifecycle": "active",
  "profiles": [
    "other-languages",
    "web"
  ],
  "commands": {
    "format": "npx --yes prettier@3.10.0 --check \"*.html\" \"**/*.css\" \"**/*.js\"",
    "lint": "python .engineering/tools/audit.py .",
    "types": "npm run test:static",
    "test": "npm run test:static && npm test",
    "build": "npm run check:pages",
    "security": "gitleaks git --redact --no-banner"
  }
}
